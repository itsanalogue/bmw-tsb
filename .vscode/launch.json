{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Launch in Watch Mode",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch"],
      "program": "${workspaceFolder}/src/index.ts",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps"
      },
      "skipFiles": ["<node_internals>/**"],
      "outFiles": ["${workspaceFolder}/**/*.ts"]
    }
  ]
}
