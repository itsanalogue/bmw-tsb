    "eslint-plugin-prettier": "^5.5.3",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "nodemailer": "^7.0.5"
