{
  "name": "bmw-tsb",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "STATE_SYNC=1 DRY_RUN=1 node dist/index.js",
    "start:post": "STATE_SYNC=1 node dist/index.js",
    "start:mark-posted": "STATE_SYNC=1 MARK_FORUM_POSTED=1 node dist/index.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "format": "prettier --write '**/*.{ts,js,json,md}'"
  },
  "devDependencies": {
    "@types/node": "^26.6.7",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^9.33.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tiptap/core": "3.35.0",
    "@tiptap/extension-bold": "3.35.0",
    "@tiptap/extension-document": "3.35.0",
    "@tiptap/extension-hard-break": "3.35.0",
    "@tiptap/extension-italic": "3.35.0",
    "@tiptap/extension-link": "3.35.0",
    "@tiptap/extension-paragraph": "3.35.0",
    "@tiptap/extension-text": "3.35.0",
    "@tiptap/extension-text-style": "3.35.0",
    "@tiptap/html": "3.35.0",
    "@tiptap/pm": "3.35.0",
    "adm-zip": "^0.6.1",
    "happy-dom": "^21.0.4",
    "html-entities": "^2.6.0",
    "nodemailer": "^10.6.1"
  },
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "overrides": {},
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
